{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Harbor",
  "theme": "luma",
  "colors": {
    "primary": "#111111",
    "light": "#3F3F46",
    "dark": "#F4F4F5"
  },
  "favicon": "/harbor-logo.png",
  "logo": {
    "light": "/harbor-wordmark-light.png",
    "dark": "/harbor-wordmark-dark.png"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#09090B"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/harbor-framework/harbor"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/harbor-framework/harbor",
      "discord": "https://discord.gg/QVvyhRw5UQ"
    },
    "links": [
      {
        "header": "社区",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/harbor-framework/harbor"
          },
          {
            "label": "Discord",
            "href": "https://discord.gg/QVvyhRw5UQ"
          },
          {
            "label": "Hub",
            "href": "https://hub.harborframework.com"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ],
    "display": "header"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.harborframework.com"
    }
  },
  "redirects": [
    {
      "source": "/jobs/model-lookup",
      "destination": "/agents/agent-auth-resolution#model-name-parsing",
      "permanent": true
    },
    {
      "source": "/agents/model-connections",
      "destination": "/agents/agent-auth-resolution",
      "permanent": true
    },
    {
      "source": "/core-concepts/agents/:slug*",
      "destination": "/agents/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/datasets/:slug*",
      "destination": "/datasets/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/harbor-hub/:slug*",
      "destination": "/harbor-hub/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/hosted-harbor/:slug*",
      "destination": "/hosted-harbor/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/jobs/:slug*",
      "destination": "/jobs/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/plugins/:slug*",
      "destination": "/plugins/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/results/:slug*",
      "destination": "/results/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/rewardkit/:slug*",
      "destination": "/rewardkit/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/sandboxes/:slug*",
      "destination": "/sandboxes/:slug*",
      "permanent": true
    },
    {
      "source": "/core-concepts/tasks/:slug*",
      "destination": "/tasks/:slug*",
      "permanent": true
    }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Harbor Hub",
          "icon": "layers",
          "href": "https://hub.harborframework.com"
        },
        {
          "anchor": "Discord",
          "icon": "messages-square",
          "href": "https://discord.gg/QVvyhRw5UQ"
        },
        {
          "anchor": "Docs MCP（文档连接协议）",
          "icon": "bot",
          "href": "/ai-agents"
        }
      ]
    },
    "languages": [
      {
        "language": "zh",
        "default": true,
        "versions": [
          {
            "version": "latest",
            "default": true,
            "tag": "最新",
            "tabs": [
              {
                "tab": "Docs（文档）",
                "groups": [
                  {
                    "group": "入门",
                    "pages": [
                      "getting-started/quick-start",
                      "getting-started/installation"
                    ]
                  },
                  {
                    "group": "核心概念",
                    "pages": [
                      "core-concepts/index"
                    ]
                  },
                  {
                    "group": "Tasks（任务）",
                    "pages": [
                      "tasks/overview",
                      "tasks/instruction",
                      "tasks/configuration",
                      "tasks/environment",
                      "tasks/skills",
                      "tasks/solution",
                      "tasks/verifier",
                      "tasks/artifacts",
                      "tasks/resources",
                      "tasks/multi-container",
                      "tasks/network-policies",
                      "tasks/multi-step",
                      "tasks/separate-verifier",
                      "tasks/lint"
                    ]
                  },
                  {
                    "group": "Datasets（数据集）",
                    "pages": [
                      "datasets/datasets",
                      "datasets/create-a-dataset",
                      "datasets/git-repos",
                      "datasets/registries",
                      "datasets/metrics"
                    ]
                  },
                  {
                    "group": "Jobs（任务运行集合）",
                    "pages": [
                      "jobs/run-a-job",
                      "jobs/configs",
                      "jobs/environment-variables",
                      "jobs/error-classification",
                      "jobs/skills",
                      "jobs/loading-trajectories",
                      "jobs/handoff",
                      "jobs/regrade",
                      "jobs/simulate-a-user",
                      "jobs/custom-verifiers",
                      "jobs/artifact-collection",
                      "jobs/stream"
                    ]
                  },
                  {
                    "group": "Harbor serve（任务服务）",
                    "pages": [
                      "harbor-serve/api-server"
                    ]
                  },
                  {
                    "group": "Agents（智能体）",
                    "pages": [
                      "agents/pre-integrated-agents",
                      "agents/acp",
                      "agents/custom-agents",
                      "agents/atif",
                      "agents/agent-auth-resolution",
                      "agents/base-url-management"
                    ]
                  },
                  {
                    "group": "Sandboxes（沙箱）",
                    "pages": [
                      "sandboxes/pre-integrated-sandboxes",
                      "sandboxes/asp",
                      "sandboxes/custom-sandboxes"
                    ]
                  },
                  {
                    "group": "Plugins（插件）",
                    "pages": [
                      "plugins/existing-plugins",
                      "plugins/custom-plugins"
                    ]
                  },
                  {
                    "group": "运行结果",
                    "pages": [
                      "results/view-job-results",
                      "results/handoff"
                    ]
                  },
                  {
                    "group": "Harbor Hub（共享平台）",
                    "pages": [
                      "harbor-hub/publish",
                      "harbor-hub/upload",
                      "harbor-hub/download",
                      "harbor-hub/hosted-jobs",
                      "harbor-hub/leaderboards",
                      "harbor-hub/sharing"
                    ]
                  },
                  {
                    "group": "Hosted Harbor（托管服务）",
                    "pages": [
                      "hosted-harbor/index",
                      "hosted-harbor/api-key",
                      "hosted-harbor/web-ui",
                      "hosted-harbor/cli",
                      "hosted-harbor/api",
                      "hosted-harbor/submitting-jobs",
                      "hosted-harbor/custom-agents",
                      "hosted-harbor/secrets",
                      "hosted-harbor/registry-credentials"
                    ]
                  },
                  {
                    "group": "Rewardkit（奖励验证工具库）",
                    "pages": [
                      "rewardkit/quick-start",
                      "rewardkit/judge-criteria",
                      "rewardkit/built-in-criteria",
                      "rewardkit/motivation-and-design"
                    ]
                  },
                  {
                    "group": "教程",
                    "pages": [
                      "tutorials/create-a-task",
                      "tutorials/create-a-verifier-with-rewardkit"
                    ]
                  },
                  {
                    "group": "开源政策",
                    "pages": [
                      "contributing/contributing",
                      "contributing/release-policy"
                    ]
                  },
                  {
                    "group": "Telemetry（遥测）",
                    "pages": [
                      "telemetry/telemetry"
                    ]
                  }
                ]
              },
              {
                "tab": "Cookbook（实践示例）",
                "groups": [
                  {
                    "group": "概览",
                    "pages": [
                      "cookbook/README"
                    ]
                  },
                  {
                    "group": "Task 示例",
                    "pages": [
                      "cookbook/harbor_cookbook/recipes/computer-use-ubuntu/README",
                      "cookbook/harbor_cookbook/recipes/computer-use-windows/README",
                      "cookbook/harbor_cookbook/recipes/dns-blacklisting/README",
                      "cookbook/harbor_cookbook/recipes/mcp-tools/README",
                      "cookbook/harbor_cookbook/recipes/multi-container/README",
                      "cookbook/harbor_cookbook/recipes/multi-reward/README",
                      "cookbook/harbor_cookbook/recipes/multi-step/README",
                      "cookbook/harbor_cookbook/recipes/simple-task/README",
                      "cookbook/harbor_cookbook/recipes/simulated-user/README",
                      "cookbook/harbor_cookbook/recipes/skills/README"
                    ]
                  },
                  {
                    "group": "优化与训练示例",
                    "pages": [
                      "cookbook/harbor_cookbook/cortex_rl/README",
                      "cookbook/harbor_cookbook/gepa/README",
                      "cookbook/harbor_cookbook/harbor_rl/README",
                      "cookbook/harbor_cookbook/prime_rl/README",
                      "cookbook/harbor_cookbook/sky_rl/README",
                      "cookbook/harbor_cookbook/tinker_rl/README"
                    ]
                  }
                ]
              },
              {
                "tab": "API & SDK",
                "openapi": {
                  "source": "/api-sdk/openapi.json",
                  "directory": "api-sdk"
                },
                "groups": [
                  {
                    "group": "Jobs",
                    "pages": [
                      "POST /jobs/submit",
                      "GET /jobs",
                      "GET /jobs/{job_id}",
                      "POST /jobs/{job_id}/pause",
                      "POST /jobs/{job_id}/resume",
                      "POST /jobs/{job_id}/cancel"
                    ]
                  },
                  {
                    "group": "Rollouts",
                    "pages": [
                      "GET /rollouts",
                      "GET /rollouts/{rollout_id}",
                      "POST /rollouts/{rollout_id}/pause",
                      "POST /rollouts/{rollout_id}/resume",
                      "POST /rollouts/{rollout_id}/cancel",
                      "POST /rollouts/{rollout_id}/retry"
                    ]
                  },
                  {
                    "group": "Files",
                    "pages": [
                      "GET /download",
                      "HEAD /download"
                    ]
                  },
                  {
                    "group": "Queries",
                    "pages": [
                      "GET /jobs/filters",
                      "GET /rollouts/filters",
                      "GET /query/schema",
                      "POST /query"
                    ]
                  },
                  {
                    "group": "Agents",
                    "pages": [
                      "GET /agents",
                      "GET /agents/{name}/options"
                    ]
                  },
                  {
                    "group": "Sandboxes",
                    "pages": [
                      "GET /sandboxes",
                      "GET /sandboxes/{name}/options"
                    ]
                  },
                  {
                    "group": "Hub",
                    "pages": [
                      "POST /hub/jobs/{job_id}/upload"
                    ]
                  }
                ]
              },
              {
                "tab": "News",
                "groups": [
                  {
                    "group": "Announcements",
                    "pages": [
                      "news"
                    ]
                  },
                  {
                    "group": "Earlier announcements",
                    "pages": [
                      "news/reward-hacking",
                      "news/job-result-sharing",
                      "news/separate-verifier-sandboxes",
                      "news/multi-step-tasks",
                      "news/harbor-cookbook",
                      "news/harbor-registry"
                    ]
                  }
                ]
              },
              {
                "tab": "Changelog",
                "groups": [
                  {
                    "group": "Releases",
                    "pages": [
                      "changelog"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "curl",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "search": {
    "prompt": "搜索文档…"
  }
}
